{
  "manifest_version": 3,
  "name": "LRN App Snippet Saver",
  "version": "1.2.0",
  "description": "Save selected text to Laravel",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus"
  ],
  "oauth2": {
    "client_id": "106622489226-9rkpm8ik58u8dr38m0on6jsvp6bkck97.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "action": {
    "default_title": "Save snippet",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "http://localhost:8000/extension/token",
        "http://127.0.0.1:8000/extension/token"
      ],
      "js": ["token-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}